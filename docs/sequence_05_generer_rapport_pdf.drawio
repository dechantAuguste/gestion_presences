        <!-- 2. vue → contrôleur -->
        <mxCell id="b2" value="②" style="text;html=1;strokeColor=none;fillColor=#3a75a8;rounded=1;fontColor=#fff;fontSize=9;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="400" y="188" width="18" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="msg2" value="POST (cours_id, date_debut, date_fin)"
                style="endArrow=block;endFill=1;html=1;strokeColor=#3a75a8;strokeWidth=2;fontSize=12;fontColor=#3a75a8;fontStyle=1;" edge="1" parent="1">
          <mxGeometry x="-0.1" y="10" relative="1" as="geometry"><mxPoint x="317" y="196" as="sourcePoint"/><mxPoint x="528" y="196" as="targetPoint"/><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <!-- 3. contrôleur → modèle -->
        <mxCell id="b3" value="③" style="text;html=1;strokeColor=none;fillColor=#27ae60;rounded=1;fontColor=#fff;fontSize=9;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="635" y="238" width="18" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="msg3" value="prepare(SELECT ... COUNT, GROUP BY cours, statut WHERE date BETWEEN)"
                style="endArrow=block;endFill=1;html=1;strokeColor=#27ae60;strokeWidth=2;fontSize=11;fontColor=#27ae60;fontStyle=1;" edge="1" parent="1">
          <mxGeometry x="-0.1" y="10" relative="1" as="geometry"><mxPoint x="552" y="255" as="sourcePoint"/><mxPoint x="768" y="255" as="targetPoint"/><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <!-- 4. modèle → MySQL -->
        <mxCell id="b4" value="④" style="text;html=1;strokeColor=none;fillColor=#d4af37;rounded=1;fontColor=#fff;fontSize=9;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="870" y="278" width="18" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="msg4" value="execute([...])"
                style="endArrow=block;endFill=1;html=1;strokeColor=#d4af37;strokeWidth=2;fontSize=12;fontColor=#b8960f;fontStyle=1;" edge="1" parent="1">
          <mxGeometry x="-0.1" y="10" relative="1" as="geometry"><mxPoint x="792" y="286" as="sourcePoint"/><mxPoint x="988" y="286" as="targetPoint"/><mxPoint as="offset"/></mxGeometry>
