        <!-- MESSAGES -->

        <!-- 1. Admin → vue -->
        <mxCell id="b1" value="①" style="text;html=1;strokeColor=none;fillColor=#0f2e59;rounded=1;fontColor=#fff;fontSize=9;fontStyle=1;align=center;" vertex="1" parent="1">
