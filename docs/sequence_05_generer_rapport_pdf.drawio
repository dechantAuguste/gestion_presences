          <mxGeometry x="-0.1" y="10" relative="1" as="geometry"><mxPoint x="768" y="356" as="sourcePoint"/><mxPoint x="552" y="356" as="targetPoint"/><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <!-- ============================================================ -->
        <!-- GÉNÉRATION PDF (self-call sur le contrôleur)                  -->
        <!-- ============================================================ -->
        <mxCell id="pdf-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#8e44ad;strokeWidth=1.5;opacity=40;" vertex="1" parent="1">
