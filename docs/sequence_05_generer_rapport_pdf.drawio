        </mxCell>

        <!-- 9. vue → Admin -->
        <mxCell id="b9" value="⑨" style="text;html=1;strokeColor=none;fillColor=#8e44ad;rounded=1;fontColor=#fff;fontSize=9;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="180" y="553" width="18" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="msg9" value="Le navigateur télécharge le fichier PDF"
                style="endArrow=open;endFill=0;html=1;strokeColor=#8e44ad;strokeWidth=2;dashed=1;fontSize=12;fontColor=#8e44ad;fontStyle=1;" edge="1" parent="1">
          <mxGeometry x="-0.1" y="10" relative="1" as="geometry"><mxPoint x="293" y="561" as="sourcePoint"/><mxPoint x="85" y="561" as="targetPoint"/><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <!-- NOTES -->
        <mxCell id="note1" value="📄 FPDF (ou TCPDF) est une bibliothèque PHP légère pour générer des PDF sans extension.&lt;br&gt;$pdf->Output('D', ...) envoie le PDF au navigateur avec l'en-tête Content-Disposition: attachment."
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;fontColor=#5d4037;fontSize=10;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="20" y="600" width="520" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="note2" value="📊 La requête SQL utilise COUNT(), GROUP BY et BETWEEN pour agréger les présences par cours et par statut sur une période donnée."
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#4a9eed;fontColor=#1a3a5c;fontSize=10;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
