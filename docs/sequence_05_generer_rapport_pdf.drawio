        </mxCell>

        <!-- 8. contrôleur → vue : Output PDF -->
        <mxCell id="b8" value="⑧" style="text;html=1;strokeColor=none;fillColor=#8e44ad;rounded=1;fontColor=#fff;fontSize=9;fontStyle=1;align=center;" vertex="1" parent="1">
