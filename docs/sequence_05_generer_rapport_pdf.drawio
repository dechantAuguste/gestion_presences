        <!-- 5. MySQL → modèle -->
        <mxCell id="b5" value="⑤" style="text;html=1;strokeColor=none;fillColor=#c0392b;rounded=1;fontColor=#fff;fontSize=9;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="870" y="313" width="18" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="msg5" value="fetchAll() → données agrégées"
                style="endArrow=open;endFill=0;html=1;strokeColor=#c0392b;strokeWidth=2;dashed=1;fontSize=12;fontColor=#c0392b;" edge="1" parent="1">
          <mxGeometry x="-0.1" y="10" relative="1" as="geometry"><mxPoint x="988" y="321" as="sourcePoint"/><mxPoint x="792" y="321" as="targetPoint"/><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <!-- 6. modèle → contrôleur -->
        <mxCell id="b6" value="⑥" style="text;html=1;strokeColor=none;fillColor=#d4af37;rounded=1;fontColor=#fff;fontSize=9;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="635" y="348" width="18" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="msg6" value="$statistiques (array)"
