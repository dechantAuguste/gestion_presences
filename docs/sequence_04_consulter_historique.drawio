<mxfile host="app.diagrams.net" agent="hermes" version="24.0.0">
  <diagram name="Consulter historique" id="seq-historique">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1"
                  tooltips="1" connect="1" arrows="1" fold="1" page="1"
                  pageScale="1" pageWidth="1050" pageHeight="640">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Diagramme de Séquence UML — Consulter l'historique des présences"
                style="text;html=1;strokeColor=none;fillColor=none;align=center;
                       verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#0f2e59;"
                vertex="1" parent="1">
          <mxGeometry x="150" y="8" width="700" height="35" as="geometry"/>
        </mxCell>

        <!-- EN-TÊTES -->
        <mxCell id="head-etud" value="Étudiant"
                style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0f2e59;strokeColor=#0a1f3d;fontColor=#fff;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="30" y="55" width="130" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="head-dash" value=":dashboard.php"
                style="rounded=0;whiteSpace=wrap;html=1;fillColor=#3a75a8;strokeColor=#2a5588;fontColor=#fff;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="280" y="55" width="170" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="head-conn" value=":ConnexionBDD"
                style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d4af37;strokeColor=#b8960f;fontColor=#fff;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="560" y="55" width="150" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="head-mysql" value="MySQL"
                style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c0392b;strokeColor=#a02d1f;fontColor=#fff;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="820" y="55" width="130" height="40" as="geometry"/>
        </mxCell>

        <!-- STÉRÉOTYPES -->
        <mxCell id="st-etud" value="&lt;&lt;acteur&gt;&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontColor=#0f2e59;fontSize=9;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="30" y="95" width="130" height="15" as="geometry"/></mxCell>
        <mxCell id="st-dash" value="&lt;&lt;vue&gt;&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontColor=#3a75a8;fontSize=9;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="280" y="95" width="170" height="15" as="geometry"/></mxCell>
        <mxCell id="st-conn" value="&lt;&lt;modèle&gt;&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontColor=#b8960f;fontSize=9;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="560" y="95" width="150" height="15" as="geometry"/></mxCell>
        <mxCell id="st-mysql" value="&lt;&lt;SGBD&gt;&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontColor=#c0392b;fontSize=9;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="820" y="95" width="130" height="15" as="geometry"/></mxCell>

        <!-- LIGNES DE VIE -->
        <mxCell id="life-etud" value="" style="endArrow=none;html=1;strokeColor=#0f2e59;strokeWidth=2;dashed=1;dashPattern=8 6;" edge="1" parent="1"><mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="95" y="115" as="sourcePoint"/><mxPoint x="95" y="590" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="life-dash" value="" style="endArrow=none;html=1;strokeColor=#3a75a8;strokeWidth=2;dashed=1;dashPattern=8 6;" edge="1" parent="1"><mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="365" y="115" as="sourcePoint"/><mxPoint x="365" y="590" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="life-conn" value="" style="endArrow=none;html=1;strokeColor=#d4af37;strokeWidth=2;dashed=1;dashPattern=8 6;" edge="1" parent="1"><mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="635" y="115" as="sourcePoint"/><mxPoint x="635" y="590" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="life-mysql" value="" style="endArrow=none;html=1;strokeColor=#c0392b;strokeWidth=2;dashed=1;dashPattern=8 6;" edge="1" parent="1"><mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="885" y="115" as="sourcePoint"/><mxPoint x="885" y="590" as="targetPoint"/></mxGeometry></mxCell>

        <!-- BARRES D'ACTIVATION -->
        <mxCell id="act-dash" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#3a75a8;strokeColor=#2a5588;opacity=35;" vertex="1" parent="1">
          <mxGeometry x="353" y="155" width="24" height="380" as="geometry"/>
        </mxCell>
        <mxCell id="act-conn" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d4af37;strokeColor=#b8960f;opacity=35;" vertex="1" parent="1">
          <mxGeometry x="623" y="240" width="24" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="act-mysql" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c0392b;strokeColor=#a02d1f;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="873" y="280" width="24" height="60" as="geometry"/>
        </mxCell>

        <!-- MESSAGES -->

        <!-- 1. Accès -->
        <mxCell id="b1" value="①" style="text;html=1;strokeColor=none;fillColor=#0f2e59;rounded=1;fontColor=#fff;fontSize=9;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="215" y="148" width="20" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="msg1" value="Accède à son dashboard (après connexion)"
                style="endArrow=block;endFill=1;html=1;strokeColor=#0f2e59;strokeWidth=2;fontSize=12;fontColor=#0f2e59;fontStyle=1;" edge="1" parent="1">
          <mxGeometry x="-0.1" y="10" relative="1" as="geometry"><mxPoint x="95" y="156" as="sourcePoint"/><mxPoint x="353" y="156" as="targetPoint"/><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <!-- 2. Vérification session (self) -->
        <mxCell id="b2" value="②" style="text;html=1;strokeColor=none;fillColor=#3a75a8;rounded=1;fontColor=#fff;fontSize=9;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="415" y="193" width="20" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="msg2" value="Vérifie $_SESSION['utilisateur_id'] + rôle = etudiant"
                style="endArrow=block;endFill=1;html=1;strokeColor=#3a75a8;strokeWidth=2;fontSize=11;fontColor=#3a75a8;fontStyle=1;" edge="1" parent="1">
          <mxGeometry x="-0.1" y="10" relative="1" as="geometry"><mxPoint x="377" y="216" as="sourcePoint"/><mxPoint x="377" y="186" as="targetPoint"/><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <!-- 3. prepare SELECT avec JOIN -->
        <mxCell id="b3" value="③" style="text;html=1;strokeColor=none;fillColor=#3a75a8;rounded=1;fontColor=#fff;fontSize=9;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="480" y="248" width="20" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="msg3" value="prepare(SELECT p.*, s.date_seance, c.titre FROM presences p JOIN seances s ... JOIN cours c ... WHERE p.etudiant_id = ? ORDER BY ...)"
                style="endArrow=block;endFill=1;html=1;strokeColor=#3a75a8;strokeWidth=2;fontSize=10;fontColor=#3a75a8;fontStyle=1;" edge="1" parent="1">
          <mxGeometry x="-0.1" y="10" relative="1" as="geometry"><mxPoint x="377" y="265" as="sourcePoint"/><mxPoint x="623" y="265" as="targetPoint"/><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <!-- 4. execute -->
        <mxCell id="b4" value="④" style="text;html=1;strokeColor=none;fillColor=#d4af37;rounded=1;fontColor=#fff;fontSize=9;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="740" y="288" width="20" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="msg4" value="execute([$etudiant_id])"
                style="endArrow=block;endFill=1;html=1;strokeColor=#d4af37;strokeWidth=2;fontSize=12;fontColor=#b8960f;fontStyle=1;" edge="1" parent="1">
          <mxGeometry x="-0.1" y="10" relative="1" as="geometry"><mxPoint x="647" y="296" as="sourcePoint"/><mxPoint x="873" y="296" as="targetPoint"/><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <!-- 5. MySQL → ConnexionBDD -->
        <mxCell id="b5" value="⑤" style="text;html=1;strokeColor=none;fillColor=#c0392b;rounded=1;fontColor=#fff;fontSize=9;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="740" y="323" width="20" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="msg5" value="fetchAll() → lignes"
                style="endArrow=open;endFill=0;html=1;strokeColor=#c0392b;strokeWidth=2;dashed=1;fontSize=12;fontColor=#c0392b;" edge="1" parent="1">
          <mxGeometry x="-0.1" y="10" relative="1" as="geometry"><mxPoint x="873" y="331" as="sourcePoint"/><mxPoint x="647" y="331" as="targetPoint"/><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <!-- 6. → dashboard -->
        <mxCell id="b6" value="⑥" style="text;html=1;strokeColor=none;fillColor=#d4af37;rounded=1;fontColor=#fff;fontSize=9;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="480" y="353" width="20" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="msg6" value="$presences (array)"
                style="endArrow=open;endFill=0;html=1;strokeColor=#d4af37;strokeWidth=2;dashed=1;fontSize=12;fontColor=#b8960f;" edge="1" parent="1">
          <mxGeometry x="-0.1" y="10" relative="1" as="geometry"><mxPoint x="623" y="361" as="sourcePoint"/><mxPoint x="377" y="361" as="targetPoint"/><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <!-- ============================================================ -->
        <!-- FRAGMENT ALT                                                 -->
        <!-- ============================================================ -->
        <mxCell id="alt-bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f4ff;strokeColor=#4a9eed;strokeWidth=2;opacity=50;" vertex="1" parent="1">
          <mxGeometry x="45" y="400" width="880" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="alt-label" value="alt" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4a9eed;strokeColor=#4a9eed;fontColor=#fff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="45" y="400" width="45" height="24" as="geometry"/>
        </mxCell>

        <!-- Gardes -->
        <mxCell id="guard-ok" value="[ count($presences) > 0 ]" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#27ae60;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="403" width="180" height="18" as="geometry"/>
        </mxCell>

        <mxCell id="alt-sep" value="" style="endArrow=none;html=1;strokeColor=#4a9eed;strokeWidth=1;dashed=1;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="45" y="480" as="sourcePoint"/><mxPoint x="925" y="480" as="targetPoint"/></mxGeometry>
        </mxCell>

        <mxCell id="guard-empty" value="[ vide ]" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#c0392b;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="483" width="80" height="18" as="geometry"/>
        </mxCell>

        <!-- 7a. Affiche tableau -->
        <mxCell id="b7a" value="⑦a" style="text;html=1;strokeColor=none;fillColor=#27ae60;rounded=1;fontColor=#fff;fontSize=9;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="215" y="438" width="20" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="msg7a" value="Affiche tableau (foreach $presences) : date, cours, statut (badge couleur)"
                style="endArrow=open;endFill=0;html=1;strokeColor=#27ae60;strokeWidth=2;dashed=1;fontSize=11;fontColor=#27ae60;fontStyle=1;" edge="1" parent="1">
          <mxGeometry x="-0.1" y="10" relative="1" as="geometry"><mxPoint x="353" y="446" as="sourcePoint"/><mxPoint x="95" y="446" as="targetPoint"/><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <!-- 7b. Affiche vide -->
        <mxCell id="b7b" value="⑦b" style="text;html=1;strokeColor=none;fillColor=#c0392b;rounded=1;fontColor=#fff;fontSize=9;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="215" y="513" width="20" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="msg7b" value="Affiche &quot;Aucun enregistrement de présence&quot;"
                style="endArrow=open;endFill=0;html=1;strokeColor=#c0392b;strokeWidth=2;dashed=1;fontSize=11;fontColor=#c0392b;fontStyle=1;" edge="1" parent="1">
          <mxGeometry x="-0.1" y="10" relative="1" as="geometry"><mxPoint x="353" y="521" as="sourcePoint"/><mxPoint x="95" y="521" as="targetPoint"/><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <!-- Note -->
        <mxCell id="note" value="📊 La requête utilise 2 JOIN : presences → seances → cours pour afficher le titre du cours et la date directement."
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#4a9eed;fontColor=#1a3a5c;fontSize=11;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="180" y="575" width="620" height="35" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
